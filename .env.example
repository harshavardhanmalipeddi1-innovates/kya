# KYA Configuration
# ================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Signing Secret (REQUIRED)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
KYA_SIGNING_SECRET=your_signing_secret_here

# Demo Authentication Key (for development/testing)
KYA_DEMO_ISSUER_KEY=your_demo_key_here

# Payment Provider: "mock" (default) or "razorpay"
KYA_PAYMENT_PROVIDER=mock

# Razorpay Configuration (only when KYA_PAYMENT_PROVIDER=razorpay)
# Get from https://dashboard.razorpay.com -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Identity Mode: "hmac" (default) or "ed25519"
KYA_IDENTITY_MODE=hmac

# Intent Classifier: "keyword" (default) or "advanced"
KYA_INTENT_CLASSIFIER=keyword

# Risk Model: "basic" (default) or "multi_signal"
KYA_RISK_MODEL=basic

# Redis URL (for distributed rate limiting)
# KYA_REDIS_URL=redis://localhost:6379

# Provider Timeout (seconds)
KYA_PROVIDER_TIMEOUT=10

# Datastore: "sqlite" (default) or "postgresql"
KYA_DATASTORE=sqlite

# JARVIS Integration (disabled by default)
KYA_JARVIS_INTEGRATION=false
